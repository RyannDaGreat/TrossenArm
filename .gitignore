# Finder metadata is local to the viewing machine.
.DS_Store

# Recreated from tracked dependency metadata and vendor revision notes.
agents/.scratchpad/python/
agents/.scratchpad/trossen_arm/
agents/.scratchpad/uv-cache/
agents/.scratchpad/uv-python/
**/.venv/
**/__pycache__/

# Machine-specific command output; keep verified findings in agents/.
agents/.scratchpad/logs/*.log

# Local camera captures and derived video frames.
agents/.scratchpad/*.png
agents/.scratchpad/*.mp4
agents/.scratchpad/frames/
agents/.scratchpad/upright-test/
agents/.scratchpad/*-motion/
agents/.scratchpad/upright-approval.txt
agents/.scratchpad/upright-status.json
agents/.scratchpad/upright-plan.json
agents/.scratchpad/upright-stage-*.png

# Rebuilt frontend artifacts and local browser-test output.
**/node_modules/
web/source/frontend/dist/
agents/.scratchpad/browser-profile/
agents/.scratchpad/*-verification.json
